# カタヅケ Web — 環境変数テンプレート（web/.env.local にコピー）
# 本番は Vercel の Environment Variables に設定
# 必須。未設定のまま next dev を起動すると API 呼び出しはエラーになる（開発時は本番 API へ落とさない）
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# NextAuth v5 セッション暗号化鍵（必須）: openssl rand -base64 32
AUTH_SECRET=change-me-to-random-base64

# LINEログイン/LINE通知連携（任意・両方揃っている場合のみ機能が有効化される）
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
# アプリの公開ベースURL（末尾スラッシュなし）。LINE Developers Console に登録する
# Callback URL（{APP_BASE_URL}/api/line/link/callback）と完全一致させること。
# LINE連携（/api/line/link/start, /api/line/link/callback）でのみ使用。
# 未設定時は Vercel の VERCEL_PROJECT_PRODUCTION_URL（本番ドメイン）にフォールバックし、
# それも無ければ連携機能が error=line_unavailable で安全側に停止する（LINEログイン自体は
# NextAuthのtrustHost設定で別途動作するため、こちらが未設定でも支障はない）。
# カスタムドメイン運用時は必ず明示設定すること。
APP_BASE_URL=http://localhost:3000

# 利用者IPの署名付き中継（backend の IP 単位レート制限が Vercel の送信元IPで
# 数えられてしまうのを防ぐ。lib/client-ip-relay.ts）。任意（未設定時は中継せず
# 従来どおり接続元IPで数える＝fail-open）。
# Vercel の Environment Variables の Production 環境にだけ Sensitive 属性で登録し、
# Development/Preview には入れないこと（値の漏洩経路を減らす運用）。
# NEXT_PUBLIC_ を付けないこと（クライアントバンドルに焼き込まれ、利用者が任意のIPを
# 名乗って署名を偽装できてしまう）。
# backend の CLIENT_IP_RELAY_SECRETS（backend/.env.example）の先頭の鍵と同じ値にすること。
# 生成: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ローカル開発（next dev）では VERCEL/VERCEL_ENV が本番と一致しないため、
# 設定しても中継は無効化される。
# CLIENT_IP_RELAY_SECRET=
