# カタヅケ Web — 環境変数テンプレート（web/.env.local にコピー）
# 本番は Vercel の Environment Variables に設定
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# NextAuth v5 セッション暗号化鍵（必須）: openssl rand -base64 32
AUTH_SECRET=change-me-to-random-base64

# LINEログイン/LINE通知連携（任意・両方揃っている場合のみ機能が有効化される）
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
# アプリの公開ベースURL（末尾スラッシュなし）。LINE Developers Console に登録する
# Callback URL（{APP_BASE_URL}/api/line/link/callback）と完全一致させること。
# LINE連携（/api/line/link/start, /api/line/link/callback）でのみ使用。未設定時は
# 連携機能が error=link_failed で安全側にフォールバックする（LINEログイン自体は
# NextAuthのtrustHost設定で別途動作するため、こちらが未設定でも支障はない）。
APP_BASE_URL=http://localhost:3000
