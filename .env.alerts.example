# 運営向けアラートの設定ファイル（このファイルを .env.alerts にコピーして値を埋める。.env.alerts は gitignore 済み）
# 実行: backend\.venv\Scripts\python.exe scripts\setup_alerts.py
#   → GitHub Secrets と Render 環境変数を登録し、Actions の疎通テストを起動して結果を表示します。
#   → --dry-run を付けると登録せずに内容だけ確認できます。

# ── 登録先の認証（あなたのアカウントのもの。スクリプトは登録にだけ使い、保存しません）──
# GitHub: Fine-grained PAT（対象リポジトリ japandaily-hub/sokuri、権限: Secrets=Read and write, Actions=Read and write）
#   作成: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=
# Render: API キー（Account Settings > API Keys）
#   作成: https://dashboard.render.com/u/settings#api-keys
RENDER_API_KEY=

# ── 通知先（未設定のチャネルはスキップ）──
# メール（Brevo は顧客向けと共用可。宛先は運営の監視用アドレス、カンマ区切り）
BREVO_API_KEY=
ALERT_EMAILS=
ALERT_MAIL_FROM=alerts@katadzuke.jp

# LINE（顧客向けとは別の、運営用 LINE 公式アカウントの Messaging API チャネル）
#   トークン: LINE Developers > 運営用チャネル > Messaging API設定 > チャネルアクセストークン（長期）
#   ユーザーID: 同 > チャネル基本設定 > 「あなたのユーザーID」（通知を受ける人ごとにカンマ区切り。各自が運営用アカウントを友だち追加しておく）
ALERT_LINE_CHANNEL_ACCESS_TOKEN=
ALERT_LINE_USER_IDS=

# Slack / Discord の Incoming Webhook（任意）
ALERT_WEBHOOK_URL=
